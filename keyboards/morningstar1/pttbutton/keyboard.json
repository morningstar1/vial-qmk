{
    "keyboard_name": "pttbutton",
    "manufacturer": "Sebastian Morgenstern",
    "maintainer": "morningstar1",
    "url": "https://github.com/morningstar1/pttbutton",
    "features": {
        "bootmagic": true,
        "mousekey": true,
        "extrakey": true,
        "console": true,
        "command": true,
        "nkro": true
    },
    "usb": {
        "vid": "0xFEED",
        "pid": "0xAFFE",
        "device_version": "1.0.0"
    },
    "matrix_pins": {
        "cols": ["B0"],
        "rows": ["A0"]
    },
    "diode_direction": "COL2ROW",
    "processor": "STM32F042",
    "bootloader": "stm32-dfu",
    "debounce": 3,
    "layouts": {
        "LAYOUT": {
            "layout": [
                {"matrix": [0, 0], "x": 0, "y": 0}
            ]
        }
    }
}
